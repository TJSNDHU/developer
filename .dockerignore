# Root .dockerignore — applies if Cloud Build uses /app as context.
# Keeps the build context small + prevents secrets from leaking into
# any layer.

# VCS / IDE / OS
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.DS_Store
Thumbs.db

# Local caches (huge — 264 MB in .aurem_cache alone)
.aurem_cache
.emergent
.pytest_cache
.ruff_cache
__pycache__
*.pyc
*.pyo
*.pyd

# Node artefacts — use **/ prefix so Docker excludes them recursively.
# Without **/, a bare `node_modules` only matches the repo root, and
# nested caches like /app/qa/simulated-user/node_modules (1.7 GB) and
# /app/vscode-extension/node_modules (126 MB) leak into the Cloud Build
# context, exceeding size/time limits and causing TerminalCloudBuildFailure.
**/node_modules
node_modules
frontend/node_modules
frontend/dist
frontend/build
frontend/.next

# Python venvs / builds
.venv
venv
env
*.egg-info
build
dist

# Secrets — MUST never bake into an image layer
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
# frontend/.env is REQUIRED at build-time (Vite reads REACT_APP_BACKEND_URL
# from it during `yarn build`). It contains no secrets — only the public
# backend URL, which is public anyway. Emergent overrides its value at
# build-time to point to the production backend.
!frontend/.env
frontend/.env.local
frontend/.env.*.local

# Local logs / dumps
*.log
logs
/var/log
test_reports
tests_output

# Non-production sidecars that don't belong in the production image.
# qa/simulated-user is a Playwright-based QA harness (1.7 GB with its
# own node_modules). vscode-extension is the local Emergent IDE plugin
# (126 MB). _extract holds the ora_grounding open-source zip contents
# used for distribution, not runtime.
qa
qa_run
vscode-extension
_extract
tests-aurem

# Stray zip artefacts served from frontend/public are still shipped by
# the frontend build; only exclude the top-level scratch copy.
/ora-grounding-clean.zip
/ora-grounding-updates.zip

# Docs / memory / dev-only content
memory
docs
*.md
!README.md

# Sqlite / offline outbox
*.sqlite
*.sqlite3
*.db
outbox.db

# Local test data
backend/tests
backend/ora_training_data
backend/.pytest_cache
backend/.ruff_cache
